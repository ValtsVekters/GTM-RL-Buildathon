# Copy to .env and fill in. Never commit .env.

# Local app database (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# Python FastAPI worker
WORKER_URL=http://localhost:8000

# LLM, all free tiers. Groq is primary; Gemini and OpenRouter :free models are fallbacks.
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Parasail (OpenAI-compatible, paid credits): tried after Groq, before Gemini. https://www.parasail.io
PARASAIL_API_KEY=
PARASAIL_CHAT_MODEL=parasail-qwen-3-next-80b-instruct

# Search: Tavily, 1,000 free credits/month. https://app.tavily.com
TAVILY_API_KEY=
# You.com search + page contents: used when TAVILY_API_KEY (search) or JINA_API_KEY (reading) is unset. https://you.com
YOU_API_KEY=

# Page reading: Jina Reader works without a key (20 RPM); a free key raises the limit. https://jina.ai/reader
JINA_API_KEY=

# Enrichment: Hunter.io, 50 free credits/month shared by search + verify. https://hunter.io/api-keys
HUNTER_API_KEY=

# Scraping sandbox: Tenki
TENKI_API_KEY=

# Billing: Flexprice meters + credit wallet
FLEXPRICE_API_KEY=

# Agents: Band Desktop (Planner, Builder, Reviewer)
BAND_API_KEY=
