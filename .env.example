# Copy to .env and fill in. Never commit .env.

# Local app database (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# Python FastAPI worker
WORKER_URL=http://localhost:8000

# LLM: OpenRouter free models while building, one good model for the demo run
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Search: Tavily (Serper as backup)
TAVILY_API_KEY=

# Enrichment: Hunter.io domain search + email verifier
HUNTER_API_KEY=

# Scraping sandbox: Tenki
TENKI_API_KEY=

# Billing: Flexprice meters + credit wallet
FLEXPRICE_API_KEY=

# Agents: Band Desktop (Planner, Builder, Reviewer)
BAND_API_KEY=
